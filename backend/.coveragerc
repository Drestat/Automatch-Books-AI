[run]
source = app
omit =
    */tests/*
    */venv/*
    */env/*
    */node_modules/*
    */alembic/*
    */__init__.py
    */app/main.py
    */app/modal_app.py

branch = True
parallel = True

[report]
precision = 2
show_missing = True
skip_covered = False
skip_empty = True

exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code
    def __repr__
    if self\.debug

    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if 0:
    if __name__ == .__main__.:

    # Don't complain about abstract methods
    @(abc\.)?abstractmethod

[html]
directory = htmlcov
title = AutoMatch Books AI - Test Coverage Report

[xml]
output = coverage.xml
